# ──────────────────────────────────────────────────────────────────────────
# No-Loss Auction — Frontend Environment Variables
#
# Copy this file to .env and fill in the values after deploying the contract.
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# ──────────────────────────────────────────────────────────────────────────

# The Soroban contract ID returned by `stellar contract deploy`
# Example: CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM
VITE_CONTRACT_ID=REPLACE_WITH_YOUR_CONTRACT_ID

# Stellar network passphrase
# Testnet: "Test SDF Network ; September 2015"
# Mainnet: "Public Global Stellar Network ; September 2015"
VITE_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Soroban-compatible RPC endpoint
# Testnet:  https://soroban-testnet.stellar.org
# Mainnet:  https://mainnet.stellar.validationcloud.io/v1/<key>
VITE_RPC_URL=https://soroban-testnet.stellar.org
